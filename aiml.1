import random




class Environment:
    def __init__(self):
        self.temperature = random.randint(18, 32)
        self.light = random.randint(0, 1000)
        self.motion = random.choice([True, False])
        self.hour = random.randint(0, 23)

    def step(self):
        self.temperature += random.randint(-1, 1)
        self.light = random.randint(0, 1000)
        self.motion = random.choice([True, False])
        self.hour = (self.hour + 1) % 24






class SmartHomeAgent:
    def __init__(self):
        self.ac = False
        self.heater = False
        self.lights = False
        self.door = True

    def act(self, env):
        if env.temperature > 26:
            self.ac = True
            self.heater = False
        elif env.temperature < 20:
            self.heater = True
            self.ac = False
        else:
            self.ac = False
            self.heater = False

        night = env.hour < 6 or env.hour >= 20

        self.lights = env.motion and (env.light < 300 or night)

        if not env.motion and night:
            self.door = True

        print("Temperature:", env.temperature)
        print("AC:", self.ac)
        print("Heater:", self.heater)
        print("Lights:", self.lights)
        print("Door Locked:", self.door)






env = Environment()
agent = SmartHomeAgent()

for i in range(8):
    print("\nTime Step:", i + 1)
    agent.act(env)
    env.step()